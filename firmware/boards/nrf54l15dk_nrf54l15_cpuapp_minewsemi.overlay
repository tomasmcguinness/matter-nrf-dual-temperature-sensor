/ {
	power {
		compatible = "gpio-keys";
		probe_1_divider_power: probe_1_divider_power {
			gpios = <&gpio1 9 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "Probe 1 Divider Power";
		};
		probe_2_divider_power: probe_2_divider_power {
			gpios = <&gpio1 10 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "Probe 2 Divider Power";
		};
	};

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpio2 10 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "Indicator LED";
		};
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio1 13 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "Reset Button";
		};
	};

	aliases {
		indicator-led = &led0;
		reset-button = &button0;
	};

	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>;
		io-channel-names = "probe_1", "probe_2", "battery";
	};
};

&gpio1 {
	status = "okay";
	sense-edge-mask = <0xffffffff>;
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
    status = "okay";

	/* Probe dividers. Powered from a GPIO switching VDD, so the node swings
	 * against the cell voltage rather than a fixed rail, and it is the NTC's
	 * high-resistance (cold) end that pushes the node up towards the supply.
	 *
	 * Gain 1/4 against the 900 mV internal reference puts full scale at 3.6 V,
	 * which covers the whole rail. Gain 1/2 would cap it at 1.8 V - with a fresh
	 * 3.0 V cell that saturates below about 16 C, and below about 5 C at 2.5 V.
	 *
	 * The battery channel below deliberately uses the same gain: the resistance
	 * is derived from the ratio of these two readings, and matching gains keeps
	 * that ratio a straight division.
	 */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN5>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <8>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN4>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <8>;
	};

	/* Battery voltage. The coin cell drives VDD directly - there is no LDO and
	 * no divider on this board - so the SAADC internal VDD input gives the cell
	 * voltage with no extra hardware and no quiescent draw.
	 *
	 * The nRF54L internal reference is 900 mV, so gain 1/4 puts full scale at
	 * 3.6 V. Note the nRF54L15 has no 1/6 gain (only 2, 1, 2/3, 2/4, 2/5, 2/6,
	 * 2/7, 2/8), so ADC_GAIN_1_6 would fail channel setup with -EINVAL.
	 */
	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_VDD>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <8>;
	};
};

// restore full RRAM and SRAM space - by default some parts are dedicated to FLRP
&cpuapp_rram {
	reg = <0x0 DT_SIZE_K(1524)>;
};

&cpuapp_sram {
	reg = <0x20000000 DT_SIZE_K(256)>;
	ranges = <0x0 0x20000000  0x40000>;
};

/* Disable unused communication peripherals */
&i2c20 {
	status = "disabled";
};

&i2c21 {
	status = "disabled";
};

&i2c22 {
	status = "disabled";
};

&spi20 {
	status = "disabled";
};

&spi21 {
	status = "disabled";
};

&spi22 {
	status = "disabled";
};

&uart20 {
	status = "disabled";
};

&uart21 {
	status = "disabled";
};

&uart22 {
	status = "disabled";
};

&uart30 {
	status = "disabled";
};

&mx25r64 {
	status = "disabled";
};

/* Disable audio/sensor peripherals if not used */
&pdm20 {
	status = "disabled";
};

&pdm21 {
	status = "disabled";
};

&i2s20 {
	status = "disabled";
};

/* Disable quadrature decoder if not used */
&qdec20 {
	status = "disabled";
};

&qdec21 {
	status = "disabled";
};

&pwm20 {
	status = "disabled";
};

&pwm21 {
	status = "disabled";
};

&pwm22 {
	status = "disabled";
};

&wdt31 {
	status = "disabled";
};

/* Disable NFC if not used */
&nfct {
	status = "disabled";
};
