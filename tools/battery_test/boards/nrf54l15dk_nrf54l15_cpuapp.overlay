/ {
	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpio2 9 GPIO_ACTIVE_HIGH>;
			label = "Indicator LED";
		};
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio1 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Reset Button";
		};
	};

	aliases {
		indicator-led = &led0;
		reset-button = &button0;
	};

	chosen {
		nordic,pm-ext-flash = &mx25r64;
	};

	zephyr,user {
		io-channels = <&adc 0>;
	};
};

/* sense-edge-mask is what lets the P1.13 edge interrupt fire out of the low
 * power states. The minewsemi overlay has always had it; without it here the
 * button behaves differently on the DK than on the custom board.
 */
&gpio1 {
	status = "okay";
	sense-edge-mask = <0xffffffff>;
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	/* Supply voltage via the SAADC internal VDD input. On the DK this reads
	 * whatever the board's VDD selector is set to rather than a cell, which
	 * is what makes it useful for sweeping the thresholds on the bench.
	 *
	 * Internal reference is 900 mV, so gain 1/4 puts full scale at 3.6 V.
	 * nRF54L15 has no 1/6 gain, so ADC_GAIN_1_6 would fail with -EINVAL.
	 */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_VDD>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <8>;
	};
};

// restore full RRAM and SRAM space - by default some parts are dedicated to FLRP
&cpuapp_rram {
	reg = <0x0 DT_SIZE_K(1524)>;
};

&cpuapp_sram {
	reg = <0x20000000 DT_SIZE_K(256)>;
	ranges = <0x0 0x20000000  0x40000>;
};

/* The DK keeps the MCUboot secondary slot in external flash, per
 * pm_static_nrf54l15dk_nrf54l15_cpuapp.yml.
 */
&mx25r64 {
	status = "okay";
};
